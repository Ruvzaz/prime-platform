generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  name          String?
  title         String?
  firstName     String?
  lastName      String?
  gender        String?
  institution   String?
  educationLevel String?
  phoneNumber   String?
  password      String? // Hashed password
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  privacyAcceptedAt DateTime? // Track when they accepted privacy policy
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Existing relations
  events   Event[]
  checkIns CheckIn[]

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Challenge Team relations
  teamMemberships TeamMember[]
  ledTeams        Team[]       @relation("TeamLeader")

  // E-Certificate relation
  certificates Certificate[]
}

enum Role {
  ADMIN
  STAFF
  USER
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  slug        String   @unique // For URL access
  startDate   DateTime
  endDate     DateTime
  location    String?
  themeColor  String?  @default("#000000")
  imageUrl    String?
  bannerUrl   String?

  // Custom Email configurations
  senderEmail        String?
  emailSubject       String?
  emailBody          String?
  emailAttachmentUrl String?
  sendEmail          Boolean @default(true)
  generateQr         Boolean @default(true)

  isActive        Boolean  @default(true)
  showOnChallenge Boolean  @default(true)
  showEventMeta   Boolean  @default(true)
  hasCertificate  Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id])

  certTemplateId String?
  certTemplate   CertTemplate? @relation(fields: [certTemplateId], references: [id], onDelete: SetNull)

  formFields    FormField[]
  registrations Registration[]
  liveConfig    LiveConfig?
  activityLogs  ActivityLog[]
  certificates  Certificate[]
  certTokens    EventCertToken[]
}

model LiveConfig {
  id      String @id @default(cuid())
  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  logoUrl        String?
  bannerUrl      String?
  welcomeMessage String?
  themeColor     String? @default("#000000")

  // Display Toggles
  showStats     Boolean  @default(true)
  showLog       Boolean  @default(true)
  layoutMode    String   @default("standard") // "standard" or "fullscreen"
  maskNames     Boolean  @default(false)
  bubbleColor   String?  @default("#4f46e5")
  bubbleOpacity Float?   @default(0.1)
  linkedEventIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormField {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label      String
  type       FieldType
  options    String[] // JSON array relevant for SELECT/RADIO
  required   Boolean   @default(false)
  allowOther Boolean   @default(false)
  order      Int       @default(0)

  @@index([eventId])
}

enum FieldType {
  TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  SELECT
  CHECKBOX
  RADIO
  DATE
  FILE
}

model Registration {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formData      Json // Stores dynamic form answers: { "fieldId": "answer" }
  referenceCode String    @unique // Generated unique code for check-in
  status        RegStatus @default(PENDING) // Default to PENDING for verification
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  checkIns     CheckIn[]
  activityLogs ActivityLog[]

  @@index([eventId])
}

enum RegStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model CheckIn {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  staffId        String
  staff          User         @relation(fields: [staffId], references: [id])
  sessionTitle   String?
  scannedAt      DateTime     @default(now())

  @@index([staffId])
}

model ActivityLog {
  id             String        @id @default(cuid())
  type           String
  action         String
  description    String
  eventId        String?
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationId String?
  registration   Registration? @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([eventId])
  @@index([registrationId])
  @@index([type])
}

// ==========================================
// NextAuth Standard Models
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// Team Challenge Models
// ==========================================

model Challenge {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  maxTeamSize Int     @default(3)
  isActive    Boolean @default(true)
  imageUrl    String?

  certTemplateId String?
  certTemplate   CertTemplate? @relation(fields: [certTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams        Team[]
  teamMembers  TeamMember[]
  certificates Certificate[]
}

model Team {
  id          String @id @default(cuid())
  name        String
  challengeId String
  leaderId    String
  inviteToken String @unique @default(cuid())
  organization String?
  region      String?
  isCompleteEmailSent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenge Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  leader    User         @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members   TeamMember[]

  @@unique([challengeId, name]) // Team name must be unique within a challenge
  @@index([challengeId])
  @@index([leaderId])
}

enum JoinStatus {
  PENDING
  APPROVED
  REJECTED
}

model TeamMember {
  id          String     @id @default(cuid())
  teamId      String
  challengeId String // Added for strict 1-challenge 1-team rule
  userId      String
  status      JoinStatus @default(PENDING)
  joinedAt    DateTime   @default(now())

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId]) // User can only join 1 team per challenge
  @@index([teamId])
  @@index([userId])
  @@index([challengeId])
}

// ==========================================
// E-Certificate Models
// ==========================================

enum CertType {
  CHALLENGE
  EVENT
}

model Certificate {
  id                 String   @id @default(cuid())
  certCode           String   @unique // e.g. "CERT-2026-X8K9L2"
  type               CertType @default(CHALLENGE)

  email              String   // Recipient email to match logged-in user
  recipientPrefix    String?  @default("")
  recipientFirstName String
  recipientLastName  String?  @default("")
  recipientFullName  String

  eventTitle         String   // e.g. "Thailand Cyber Top Talent 2026"
  issueDate          String   // e.g. "31 สิงหาคม 2569"
  status             String   @default("ACTIVE") // "ACTIVE" or "REVOKED"

  challengeId        String?
  challenge          Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  eventId            String?
  event              Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  campaignId         String?
  campaign           CertCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  userId             String?
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([email])
  @@index([certCode])
}

model EventCertToken {
  id          String   @id @default(cuid())
  token       String   @unique // 6-character unique claim token e.g. "A7K9X2"
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  isUsed      Boolean  @default(false)
  claimedName String?  // Recipient's full name entered when claimed
  claimedAt   DateTime?

  certCode    String?  // Generated Certificate code when claimed

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([token])
  @@index([eventId])
}

model CertTemplate {
  id                 String   @id @default(cuid())
  name               String
  backgroundImageUrl String
  layoutConfig       Json
  isDefault          Boolean  @default(false)
  events             Event[]
  challenges         Challenge[]
  campaigns          CertCampaign[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CertCampaign {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  description        String?
  issueDate          String
  isActive           Boolean  @default(true)

  certTemplateId     String?
  certTemplate       CertTemplate? @relation(fields: [certTemplateId], references: [id], onDelete: SetNull)

  certificates       Certificate[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
}


